#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

start_service() {
	local enabled log_level exit_node_rules

	config_load netbird
	config_get_bool enabled settings enabled 1
	config_get log_level settings log_level info
	config_get_bool exit_node_rules settings exit_node_rules 0

	[ "$enabled" -eq 1 ] || return 0

	# /var is tmpfs on OpenWrt; keep enrollment and WireGuard keys on the overlay.
	mkdir -p /etc/netbird /var/lib
	if [ ! -L /var/lib/netbird ]; then
		rm -rf /var/lib/netbird
		ln -s /etc/netbird /var/lib/netbird
	fi

	procd_open_instance netbird
	procd_set_param command /usr/bin/netbird service run --log-file console --log-level "$log_level"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ "$exit_node_rules" -eq 1 ]; then
		procd_open_instance exit-rules
		procd_set_param command /usr/libexec/netbird-exit-rules.sh
		procd_set_param respawn
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger netbird
}
